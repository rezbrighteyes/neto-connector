<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_neto" model="ir.ui.view">
        <field name="name">res.partner.form.neto</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_neto_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="neto_payment_count == 0">
                    <field name="neto_payment_count"
                           widget="statinfo"
                           string="Neto Payments"/>
                </button>
            </xpath>
            <notebook position="inside">
                <page string="Neto" name="neto_tab">
                    <div class="alert alert-warning" invisible="not neto_on_credit_hold">
                        &#9888;&#65039; This customer is on credit hold in Neto.
                    </div>
                    <div class="alert alert-info" invisible="neto_status != 'inactive'">
                        &#8505;&#65039; Neto had this customer switched OFF as at the last
                        sync. They are still active in Odoo and can be ordered for
                        &#8212; this records what Neto said, it is not a block.
                    </div>
                    <group string="Neto Identity">
                        <field name="neto_username" readonly="1"/>
                        <field name="neto_status"/>
                        <field name="neto_classification"/>
                    </group>
                    <group string="Credit (from Neto)">
                        <field name="neto_account_balance" readonly="1"/>
                        <field name="neto_available_credit" readonly="1"/>
                        <field name="credit_limit"/>
                        <field name="neto_on_credit_hold"/>
                    </group>
                    <group string="Terms &amp; Manager">
                        <field name="property_payment_term_id"/>
                        <field name="user_id" string="Sales Representative"/>
                        <field name="neto_last_sync" readonly="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Filters for the Neto status. Bare filter elements at search level, NOT
         wrapped in a group element: Odoo 19 rejects a group inside a search view
         outright, and it collects group_by filters into the Group By menu by
         itself. -->
    <record id="view_res_partner_filter_neto" model="ir.ui.view">
        <field name="name">res.partner.select.neto</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="type_company" position="after">
                <separator/>
                <filter string="Inactive in Neto" name="neto_inactive"
                        domain="[('neto_status', '=', 'inactive')]"/>
                <filter string="Active in Neto" name="neto_active"
                        domain="[('neto_status', '=', 'active')]"/>
                <filter string="Never synced with Neto" name="neto_unknown"
                        domain="[('neto_status', '=', False)]"/>
                <separator/>
                <filter string="On Credit Hold (Neto)" name="neto_credit_hold"
                        domain="[('neto_on_credit_hold', '=', True)]"/>
                <filter string="Neto Status" name="group_neto_status"
                        context="{'group_by': 'neto_status'}"/>
                <separator/>
            </filter>
        </field>
    </record>

</odoo>
